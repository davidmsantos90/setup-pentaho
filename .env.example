# Copy this file to .env and replace the placeholder values with your local setup.
# The script sources .env automatically at runtime.

# Root directory where builds are downloaded and extracted.
root_directory=~/Pentaho

# Internal build repository URL.
build_repository=https://your-internal-build-repository.example.com

# Optional runtime settings.
secure=true
launch_server=false

# Default setup values.
version=10.3.0.0
mode=server
build=snapshot
feature=master
plugins=paz-plugin-ee,pdd-plugin-ee,pir-plugin-ee

# Supported values:
#   mode: server, pdi, pdi-osgi
#   build: snapshot, qat, release
#   feature: master, WCAG-branch, schedule-plugin
#   plugins: comma-separated server plugin IDs (for mode=server only)
